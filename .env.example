# ---- 数据库 ----
DATABASE_URL=jdbc:postgresql://localhost:5432/fastvue3
DATABASE_USERNAME=fastvue3
DATABASE_PASSWORD=fastvue3

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- CORS（多个来源用逗号分隔）----
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*

# ---- JWT（生产环境务必替换为至少 32 字节的随机字符串）----
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long

# ---- 默认管理员密码（生产环境必须设置，dev 未设置时回退为 admin123）----
ADMIN_PASSWORD=admin123
