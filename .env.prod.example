# Copy to a private file outside Git, replace every value, then use --env-file.
# Generate JWT_SECRET with: openssl rand -base64 48
DATABASE_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGIN_PATTERNS=https://app.example.com
APP_PORT=8080

# Optional budgets: lock <= statement <= transaction; file request needs multipart overhead.
DB_LOCK_TIMEOUT_MILLIS=5000
DB_STATEMENT_TIMEOUT_SECONDS=15
DB_TRANSACTION_TIMEOUT_SECONDS=20
FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_REQUEST_SIZE_BYTES=11534336
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=10
NOTIFICATION_POLL_INTERVAL_MS=5000
